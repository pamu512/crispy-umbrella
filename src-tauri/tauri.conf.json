{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cti-command-center",
  "version": "0.1.0",
  "identifier": "com.pamu512.crispyumbrella",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "additionalWatchFolders": [
      "binaries",
      "capabilities",
      "entitlements",
      "resources/scripts",
      "resources/sqlite_extensions"
    ],
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CTI Command Center",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "base-uri": ["'self'"],
        "font-src": ["'self'", "data:", "https://fonts.gstatic.com"],
        "img-src": ["'self'", "asset:", "https://asset.localhost", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "script-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://ipc.localhost",
          "http://127.0.0.1:*",
          "http://localhost:*",
          "http://0.0.0.0:*",
          "https://127.0.0.1:*",
          "https://localhost:*",
          "ws://127.0.0.1:*",
          "ws://localhost:*",
          "wss://127.0.0.1:*",
          "wss://localhost:*",
          "tauri://localhost",
          "http://tauri.localhost",
          "https://tauri.localhost"
        ],
        "media-src": ["'self'", "blob:", "data:"],
        "worker-src": ["'self'", "blob:"],
        "object-src": ["'none'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://ipc.localhost",
          "http://127.0.0.1:*",
          "http://localhost:*",
          "http://0.0.0.0:*",
          "https://127.0.0.1:*",
          "https://localhost:*",
          "ws://127.0.0.1:*",
          "ws://localhost:*",
          "wss://127.0.0.1:*",
          "wss://localhost:*",
          "http://localhost:3000",
          "ws://localhost:3000",
          "tauri://localhost",
          "http://tauri.localhost",
          "https://tauri.localhost"
        ],
        "img-src": ["'self'", "asset:", "https://asset.localhost", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "script-src": ["'self'", "'unsafe-inline'"]
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/scripts/**",
          "$RESOURCE/sqlite_extensions/**"
        ]
      },
      "capabilities": ["default"],
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": false,
      "pattern": {
        "use": "brownfield"
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "public.app-category.developer-tools",
    "copyright": "",
    "shortDescription": "CTI Command Center",
    "longDescription": "Local CTI workspace, vault, and agent tooling.",
    "resources": [
      "resources/scripts/**/*",
      "resources/sqlite_extensions/**/*"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "minimumWebview2Version": "109.0.1518.140",
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": null,
      "nsis": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "ca-certificates",
          "libssl3 | libssl1.1",
          "libsqlite3-0"
        ],
        "files": {},
        "section": "utils"
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "files": {}
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements/macos/production.entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "files": {},
      "infoPlist": "Info.plist",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "android": {
      "autoIncrementVersionCode": false,
      "minSdkVersion": 24,
      "versionCode": 1
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "useLocalToolsDir": false,
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/intelx-scraper",
      "binaries/ioc-news-crawler",
      "binaries/mac-stealer",
      "binaries/ransomware-live",
      "binaries/cve-nvd"
    ]
  },
  "plugins": {
    "log": {
      "level": "info"
    }
  }
}
