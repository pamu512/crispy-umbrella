# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Optional local Python env for `npm run build:python`
/.venv/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tauri PyInstaller sidecars (run `npm run build:python`; triple-suffixed names)
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep

# Python / PyInstaller
*.egg-info/
__pycache__/
*.py[cod]
dist/
build/
*.spec
pyi_bundle/

# Generated MROP embedding feed (see scripts/ingest_mrop_rag.py)
docs/mrop-rag/mrop_chunks.jsonl

# Local backup copies next to JSON configs
*.backup.*

# Bundled tools: never commit real API key lists (see *.example.txt in each secrets/)
src-tauri/resources/scripts/**/secrets/*.txt

# Local-generated screenshot dumps (not shipped in HEAD / ZIP / Tauri bundle)
src-tauri/resources/scripts/Phishing_and_Social_Media_All-in-one/examples/screenshots_output/
src-tauri/resources/scripts/Phishing_and_Social_Media_All-in-one/screenshots/Jack_output/
